# =============================================================================
# GAZNGER SERVER — PRODUCTION ENVIRONMENT VARIABLES (Railway)
#
# Copy each row below into Railway's project → Variables UI. Do NOT commit a
# filled `.env.production` to git. Comments are for the operator only.
#
# Generate fresh secrets per environment — never reuse local dev values.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=production
# PORT is set automatically by Railway — do NOT hard-code it.

# --- MongoDB Atlas -----------------------------------------------------------
# Atlas → Database → Connect → Drivers → copy the SRV URI. Replace <password>
# with the DB user's password (URL-encode special chars). The trailing path
# selects the database; use `gaznger` for prod, `gaznger-staging` for staging.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gaznger?retryWrites=true&w=majority

# --- JWT ---------------------------------------------------------------------
# Generate with: openssl rand -hex 64  (do this twice, one per secret)
# Each secret MUST be different. Rotation: set JWT_SECRET_NEXT during overlap,
# bump JWT_KID, deploy, then swap NEXT into the primary slot.
JWT_SECRET=<openssl rand -hex 64>
JWT_REFRESH_SECRET=<openssl rand -hex 64>
JWT_KID=k1
# Optional overlap secrets — set during a rotation window only.
# JWT_SECRET_NEXT=
# JWT_REFRESH_SECRET_NEXT=

# --- CORS --------------------------------------------------------------------
# Comma-separated; NO trailing comma. Must be non-empty in production or the
# server will refuse to boot (audit F.1).
ALLOWED_ORIGINS=https://app.gaznger.com,https://admin.gaznger.com

# --- Public base URL ---------------------------------------------------------
# The Railway public URL (or your custom domain). Used in generated invoices
# and password-reset links. NO trailing slash.
EXPO_PUBLIC_BASE_URL=https://api.gaznger.com

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Maps -------------------------------------------------------------
# Server-side reverse geocoding + Directions API. Restrict by Railway egress
# IP in GCP Console for prod (Maps Platform → Credentials → API restrictions).
GOOGLE_MAPS_API_KEY=

# --- Firebase Admin (push notifications) -------------------------------------
# The private key MUST be wrapped in double quotes with literal \n for newlines.
# Generate from Firebase Console → Project Settings → Service Accounts →
# Generate New Private Key, then extract the three fields below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<full key with \n line breaks>\n-----END PRIVATE KEY-----\n"

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=re_<live_key>
# Sender domain MUST be verified at https://resend.com/domains before prod
# email will deliver to non-account addresses.

# --- Paystack ----------------------------------------------------------------
# LIVE keys for prod. Test keys (sk_test_/pk_test_) should NEVER appear here.
# Webhook URL configured in Paystack dashboard:
#   https://api.gaznger.com/api/payments/webhook
PAYSTACK_SECRET_KEY_LIVE=sk_live_<replace>
PAYSTACK_PUBLIC_KEY_LIVE=pk_live_<replace>
# Legacy single-key fallback — set to the LIVE secret for safety.
PAYSTACK_SECRET_KEY=sk_live_<replace>
PAYSTACK_PUBLIC_KEY=pk_live_<replace>

# --- WhatsApp Business Cloud API (OTP delivery) ------------------------------
# REQUIRED in production. If unset, server fails fast at boot (audit A.1) —
# this is a security guarantee, not a bug. See:
#   docs/handoff/whatsapp-business-setup.md
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_OTP_TEMPLATE=gaznger_otp
WA_TEMPLATE_LANG=en
WA_GRAPH_VERSION=v21.0

# Soft-launch escape hatch (DELETE WHEN WA IS LIVE).
#
# Set to the literal string "true" to let the server boot in production
# WITHOUT WhatsApp credentials. Dev OTP `123456` will be accepted for
# every signup/login. This is the only way to deploy before Meta finishes
# template approval (~1–3 business days from submission).
#
# When the WA_* values above are populated, REMOVE this variable from
# Railway. The next deploy will re-engage the prod boot gate automatically.
#
# Loud warnings will print every 30 min while this is on.
# ALLOW_DEV_OTP_IN_PROD=true

# --- Points rewards ----------------------------------------------------------
POINTS_ORDER_PLACED=100
POINTS_ORDER_DELIVERED=50
POINTS_RATE_STATION=50

# --- Delivery & dispatch -----------------------------------------------------
DELIVERY_BASE_FEE=500
DELIVERY_PER_KM=100
RIDER_DISPATCH_RADIUS_KM=10
RIDER_DISPATCH_TIMEOUT_SECONDS=180
RIDER_DISPATCH_MAX_ROUNDS=3

# --- Platform commissions (first-boot defaults; PlatformConfig is canonical)
PAYSTACK_SPLITS_ENABLED=false
PLATFORM_FUEL_COMMISSION=10
PLATFORM_DELIVERY_COMMISSION=5

# --- Service fee -------------------------------------------------------------
# Basis points off the fuel cost. 200 = 2%. (audit C.4)
SERVICE_FEE_BPS=200
