# =============================================================================
# GAZNGER SERVER — ENVIRONMENT VARIABLES
# Copy this file to .env.local (development) or .env.production (production)
# and fill in your actual values. Never commit real secrets to version control.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development              # "development" | "production"
PORT=5000                         # HTTP port the server listens on

# --- MongoDB -----------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gaznger
#   For local dev: mongodb://localhost:27017/gaznger

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=<generate: openssl rand -hex 32>
#   Access token secret — keep separate from refresh secret
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
#   Refresh token secret — MUST be different from JWT_SECRET

# --- CORS --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000
#   Comma-separated list of allowed client origins (used in production)
#   Includes :3000 for the Next.js admin dashboard
#   Example production value: https://admin.gaznger.com,https://app.gaznger.com

# --- Client base URL ---------------------------------------------------------
EXPO_PUBLIC_BASE_URL=http://localhost:5000
#   The public URL of this server, used by the mobile client
#   Production example: https://gaznger-backend.onrender.com

# --- Cloudinary (image uploads) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Google Maps -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- Firebase Admin (push notifications) ------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n"
#   Wrap the private key in double quotes and use \n for newlines

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Get your API key at: https://resend.com/api-keys
#   Free tier: 3,000 emails/month, send to verified domains only
#   With onboarding@resend.dev sender, delivery is limited to your Resend account email

# --- Paystack (payments) -----------------------------------------------------
# Legacy single-key fallback (used when the env-specific keys below are unset).
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
#   Test keys start with sk_test_/pk_test_, live keys with sk_live_/pk_live_
#   Get your keys at: https://dashboard.paystack.com/#/settings/developer

# Env-aware keys — picked by NODE_ENV. Strongly preferred for prod safety.
PAYSTACK_SECRET_KEY_TEST=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY_TEST=pk_test_REPLACE_ME
PAYSTACK_SECRET_KEY_LIVE=sk_live_REPLACE_ME
PAYSTACK_PUBLIC_KEY_LIVE=pk_live_REPLACE_ME
#   Webhook secret matches whichever secret key is active. Configure the
#   webhook URL on https://dashboard.paystack.com/#/settings/webhook
#   pointing to <server>/api/payments/webhook

# --- Points rewards ----------------------------------------------------------
POINTS_ORDER_PLACED=100           # Points awarded when an order is placed
POINTS_ORDER_DELIVERED=50         # Points awarded when an order is delivered
POINTS_RATE_STATION=50            # Points awarded for rating a station

# --- Delivery & dispatch -----------------------------------------------------
DELIVERY_BASE_FEE=500             # Base delivery fee in kobo (₦500)
DELIVERY_PER_KM=100               # Additional fee per km in kobo (₦100/km)
RIDER_DISPATCH_RADIUS_KM=10       # Max radius to search for riders (km)
RIDER_DISPATCH_TIMEOUT_SECONDS=180 # Seconds before re-broadcasting dispatch (3 min)
RIDER_DISPATCH_MAX_ROUNDS=3       # Max broadcast rounds before cancelling order

# --- Platform commissions ----------------------------------------------------
# These env values are now ONLY used as first-boot defaults. The runtime
# source of truth is the PlatformConfig singleton, editable from the admin
# dashboard at /api/admin/config. See server/src/models/PlatformConfig.ts.
PAYSTACK_SPLITS_ENABLED=false     # Enable Paystack split payments (requires business account)
PLATFORM_FUEL_COMMISSION=10       # Platform cut from fuel sales (%)
PLATFORM_DELIVERY_COMMISSION=5    # Platform cut from delivery fees (%)
