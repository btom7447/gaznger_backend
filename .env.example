# =============================================================================
# GAZNGER SERVER — ENVIRONMENT VARIABLES
# Copy this file to .env.local (development) or .env.production (production)
# and fill in your actual values. Never commit real secrets to version control.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development              # "development" | "production"
PORT=5000                         # HTTP port the server listens on

# --- MongoDB -----------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gaznger
#   For local dev: mongodb://localhost:27017/gaznger

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=<generate: openssl rand -hex 32>
#   Access token secret — keep separate from refresh secret
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
#   Refresh token secret — MUST be different from JWT_SECRET

# --- CORS --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19000
#   Comma-separated list of allowed client origins (used in production)
#   Example production value: https://gaznger.com,https://app.gaznger.com

# --- Client base URL ---------------------------------------------------------
EXPO_PUBLIC_BASE_URL=http://localhost:5000
#   The public URL of this server, used by the mobile client
#   Production example: https://gaznger-backend.onrender.com

# --- Cloudinary (image uploads) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Google Maps -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- Firebase Admin (push notifications) ------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n"
#   Wrap the private key in double quotes and use \n for newlines

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Get your API key at: https://resend.com/api-keys
#   Free tier: 3,000 emails/month, send to verified domains only
#   With onboarding@resend.dev sender, delivery is limited to your Resend account email

# --- Paystack (payments) -----------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Test key starts with sk_test_, live key starts with sk_live_
#   Get your keys at: https://dashboard.paystack.com/#/settings/developer

# --- Points rewards ----------------------------------------------------------
POINTS_ORDER_PLACED=100           # Points awarded when an order is placed
POINTS_ORDER_DELIVERED=50         # Points awarded when an order is delivered
POINTS_RATE_STATION=50            # Points awarded for rating a station
